# Qiita アクセストークン
# https://qiita.com/settings/applications で取得してください
# スコープ: read_qiita / write_qiita
QIITA_TOKEN=your_qiita_token_here

# Anthropic Claude API Key（将来のAPI連携用）
# https://console.anthropic.com/ で取得してください
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 使用するモデル（省略時: claude-sonnet-4-6）
# 例: claude-opus-4-8 / claude-sonnet-4-6 / claude-haiku-4-5
# CLAUDE_MODEL=claude-sonnet-4-6
