{
  "env": {
    "NODE_OPTIONS": "--use-system-ca"
  },
  "permissions": {
    "allow": [
      "Write(public/**)",
      "Write(public/**/*)",
      "Write(public/**/*.md)",
      "Write(public/**/*.json)",
      "Edit(public/**)",
      "Edit(public/**/*)",
      "Edit(public/**/*.md)",
      "Edit(public/**/*.json)",
      "Edit(config/topics.yaml)",
      "Bash(mkdir *)",
      "Bash(npx qiita publish *)",
      "Bash(QIITA_TOKEN=*)",
      "WebFetch"
    ]
  }
}
